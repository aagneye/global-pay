# Copy to .env (gitignored). TESTNET KEYS ONLY.

# Base Sepolia public RPC. Use a provider URL (Alchemy, QuickNode, ...) for reliability.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer / admin key for Base Sepolia. Never put a mainnet key here.
DEPLOYER_PRIVATE_KEY=

# Addresses granted roles at deploy time (matching keys live in services/api/.env)
QUOTE_SIGNER_ADDRESS=
OPERATOR_ADDRESS=
PAUSER_ADDRESS=
TREASURY_ADDRESS=

# Circle USDC on Base Sepolia. Check this against Circle's docs before deploying.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Optional: Etherscan API key (works for Basescan) for contract verification
ETHERSCAN_API_KEY=
