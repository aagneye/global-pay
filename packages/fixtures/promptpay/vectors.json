{
  "$schema": "./vectors.schema.json",
  "version": 1,
  "description": "PromptPay (Thai QR, EMVCo) test vectors shared by the Dart and TypeScript parsers. All IDs are fake. CRC is CRC-16/CCITT-FALSE over the payload including \"6304\".",
  "valid": [
    {
      "name": "personal mobile, static, no amount",
      "payload": "00020101021129370016A0000006770101110113006681234567853037645802TH6304823E",
      "expected": {
        "initiation": "static",
        "kind": "personal",
        "targetType": "mobile",
        "targetId": "0066812345678",
        "amount": null,
        "currency": "764",
        "country": "TH"
      }
    },
    {
      "name": "personal mobile, dynamic, 100.00 THB",
      "payload": "00020101021229370016A0000006770101110113006681234567853037645406100.005802TH6304F142",
      "expected": {
        "initiation": "dynamic",
        "kind": "personal",
        "targetType": "mobile",
        "targetId": "0066812345678",
        "amount": "100.00",
        "currency": "764",
        "country": "TH"
      }
    },
    {
      "name": "personal national ID, dynamic, 59.50 THB",
      "payload": "00020101021229370016A000000677010111021312345678901235303764540559.505802TH6304EB58",
      "expected": {
        "initiation": "dynamic",
        "kind": "personal",
        "targetType": "nationalId",
        "targetId": "1234567890123",
        "amount": "59.50",
        "currency": "764",
        "country": "TH"
      }
    },
    {
      "name": "personal e-wallet, static",
      "payload": "00020101021129390016A000000677010111031514000012345678953037645802TH63044B8E",
      "expected": {
        "initiation": "static",
        "kind": "personal",
        "targetType": "eWallet",
        "targetId": "140000123456789",
        "amount": null,
        "currency": "764",
        "country": "TH"
      }
    },
    {
      "name": "merchant bill payment, dynamic, 250.00 THB, with name and city",
      "payload": "00020101021230600016A00000067701011201150999999999999010207INV00010306TABLE753037645406250.005802TH5919GLOBALPAY TEST CAFE6007BANGKOK6304E9FD",
      "expected": {
        "initiation": "dynamic",
        "kind": "merchant",
        "targetType": "biller",
        "targetId": "099999999999901",
        "reference1": "INV0001",
        "reference2": "TABLE7",
        "amount": "250.00",
        "currency": "764",
        "country": "TH",
        "merchantName": "GLOBALPAY TEST CAFE",
        "merchantCity": "BANGKOK"
      }
    },
    {
      "name": "merchant bill payment, static, no amount",
      "payload": "00020101021130490016A00000067701011201150999999999999020206SHOP4253037645802TH63041C87",
      "expected": {
        "initiation": "static",
        "kind": "merchant",
        "targetType": "biller",
        "targetId": "099999999999902",
        "reference1": "SHOP42",
        "amount": null,
        "currency": "764",
        "country": "TH"
      }
    }
  ],
  "invalid": [
    {
      "name": "checksum mismatch",
      "payload": "00020101021229370016A0000006770101110113006681234567853037645406100.005802TH6304F140",
      "error": "crc_mismatch"
    },
    {
      "name": "missing checksum tag",
      "payload": "00020101021229370016A0000006770101110113006681234567853037645406100.005802TH",
      "error": "missing_crc"
    },
    {
      "name": "TLV length overruns payload",
      "payload": "0002010102122999A0006304B799",
