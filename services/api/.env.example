# Copy to .env (gitignored). TESTNET KEYS ONLY. Empty values are treated as unset.
# NODE_ENV=production refuses local and sandbox settings: chain 31337, anvil's public keys, guessable secrets,
# RATE_SOURCE=fixed, turning rate limits off, simulated partners, and Xendit/MoonPay test keys or the sandbox widget.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Behind a load balancer or tunnel: which proxies may report the client's IP (X-Forwarded-For), which
# rate limits key on. Leave unset when clients connect directly. A hop count (1 behind one load balancer)
# or the proxies' addresses/CIDRs, comma-separated. `true` trusts any X-Forwarded-For, which clients can forge.
TRUST_PROXY=
# The largest request body accepted, in bytes (64 KiB). Bigger ones get 413 payload_too_large.
BODY_LIMIT_BYTES=65536

# Rate limits: requests per window. Each limited route has its own budget; a 429 carries Retry-After.
# Counters are in memory, per process. Set RATE_LIMIT_ENABLED=false only for load tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
# Every other route, per IP (shared by those routes). /health is never limited.
RATE_LIMIT_MAX=600
# POST /auth/nonce and POST /auth/verify, per IP.
RATE_LIMIT_AUTH_MAX=30
# Per signed-in user (per IP when signed out): POST /quotes and POST /payments; POST /onramp/orders;
# tap-to-pay request, tap, claim and approve; POST /devices.
RATE_LIMIT_PAYMENTS_MAX=30
RATE_LIMIT_ONRAMP_MAX=10
RATE_LIMIT_P2P_MAX=30
RATE_LIMIT_DEVICES_MAX=10
# Per IP: partner webhooks (generous: partners retry in bursts) and the operator API (/ops/api/*).
RATE_LIMIT_WEBHOOKS_MAX=1200
RATE_LIMIT_OPS_MAX=120

# Postgres from the root docker-compose.yml. If you set POSTGRES_PORT there, use the same port here.
DATABASE_URL=postgresql://globalpay:globalpay@localhost:5432/globalpay
# Leave unset (10 connections). Set to 1 with `npx prisma dev`, which serves one connection at a time.
DATABASE_POOL_SIZE=

# Sign-in. JWT_SECRET must be at least 32 characters (and random in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=86400
# The domain sign-in messages name (EIP-4361). The server writes the message; the app signs it.
SIWE_DOMAIN=globalpay.local

# Chain: Base Sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
CHAIN_POLL_MS=1000
EXPLORER_URL=https://sepolia.basescan.org
# Circle USDC on Base Sepolia. Check this against Circle's docs.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Set by `npm run testnet -- record` after deploying (docs/testnet.md). Quotes return 503 until it's set.
SETTLEMENT_ADDRESS=

# Backend keys (testnet only). Their addresses get roles in the settlement contract.
QUOTE_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Local chain instead: start anvil, run contracts/script/DeployLocal.s.sol, then use these.
# They're anvil's public test keys (#2 quote signer, #3 relayer): never use them anywhere else
# (production refuses them).
# CHAIN_ID=31337
# RPC_URL=http://127.0.0.1:8545
# USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# SETTLEMENT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# QUOTE_SIGNER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# RELAYER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Quotes
QUOTE_TTL_SECONDS=60
SPREAD_BPS=100
# true in production: refuse personal (tag 29) PromptPay QRs
MERCHANT_QR_ONLY=false

# Exchange rate. public: Coinbase's public USDC rates. fixed: FIXED_USDC_THB_RATE (offline).
RATE_SOURCE=public
FIXED_USDC_THB_RATE=35.00

# Payouts (ADR 0008). simulated: no money moves. xendit: Xendit payouts (sandbox keys only).
PAYOUT_PROVIDER=simulated
PAYOUT_POLL_MS=2000
# How often to ask the partner about a pending payout.
PAYOUT_RECHECK_MS=5000
# A payout still pending after this long becomes UNKNOWN (never settled or refunded automatically).
PAYOUT_PENDING_DEADLINE_MS=1800000
# Refuse quotes that would leave less than this in the partner's float (THB).
PAYOUT_FLOAT_BUFFER_THB=0

# Simulated partner
PAYOUT_DELAY_MS=3000
# 0..1. Set to 1 to force failures and exercise refunds.
PAYOUT_FAILURE_RATE=0
# 0..1. Set to 1 to make every outcome unclear and exercise the operator console.
PAYOUT_UNKNOWN_RATE=0

# Xendit (PAYOUT_PROVIDER=xendit). Test keys from the Xendit dashboard (test mode) only.
XENDIT_SECRET_KEY=
# Dashboard → Settings → Webhooks: the verification token. Webhook URL: <public URL>/webhooks/payouts/xendit
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
# The THB channel for PromptPay IDs (personal QRs), from GET /payouts_channels?currency=THB.
XENDIT_PROMPTPAY_CHANNEL=
# Sandbox only, refused in production: map demo QR targets to Xendit test accounts, e.g.
# {"099999999999901":{"channelCode":"TH_KBANK","accountNumber":"1234567890","accountHolderName":"Test Cafe"}}
PAYOUT_TEST_DESTINATIONS=

# Operator console at /ops. Leave unset to turn it off. At least 32 characters; generate like JWT_SECRET.
OPS_API_TOKEN=
# Flag an UNKNOWN payout as needing a person after this long.
OPS_ESCALATE_AFTER_MS=1800000
# An operator can approve a refund only after the payout has been UNKNOWN this long.
OPS_REFUND_COOLOFF_MS=3600000
# Show a transaction (settle, refund, tap-to-pay transfer) as stuck when it has no receipt after this long.
OPS_STUCK_TX_AFTER_MS=600000
# Alert thresholds: relayer gas (ETH) and payout float (THB).
OPS_MIN_RELAYER_ETH=0.005
OPS_MIN_PAYOUT_FLOAT_THB=0

# Add money (ADR 0009). simulated: a checkout page on this API that mints test USDC on anvil (local only).
# moonpay: MoonPay, sandbox keys first.
ONRAMP_PROVIDER=simulated
# MoonPay's minimum for THB is 800.
ONRAMP_MIN_THB=800
ONRAMP_MAX_THB=50000
# An unpaid order expires after this long.
ONRAMP_ORDER_TTL_MS=3600000
ONRAMP_MAX_OPEN_ORDERS=3
ONRAMP_POLL_MS=5000
# How often to ask the partner about an open order.
ONRAMP_RECHECK_MS=15000
# Where the partner delivers, if not the payment chain. MoonPay's sandbox delivers a test token on
# Ethereum Sepolia: set its RPC, chain ID (11155111), token address and explorer here.
ONRAMP_RPC_URL=
ONRAMP_CHAIN_ID=
ONRAMP_TOKEN_ADDRESS=
ONRAMP_EXPLORER_URL=
# Blocks to wait after the delivery; defaults to INDEXER_CONFIRMATIONS.
ONRAMP_CONFIRMATIONS=
# Optional https link the widget sends the user back to.
ONRAMP_REDIRECT_URL=

# MoonPay (ONRAMP_PROVIDER=moonpay), from the dashboard's Developers page. Test keys: pk_test_/sk_test_.
MOONPAY_PUBLISHABLE_KEY=
MOONPAY_SECRET_KEY=
# Webhook URL: <public URL>/webhooks/onramp/moonpay
MOONPAY_WEBHOOK_KEY=
# The sandbox widget. Production uses https://buy.moonpay.com and refuses the sandbox.
MOONPAY_WIDGET_URL=https://buy-sandbox.moonpay.com
MOONPAY_API_URL=https://api.moonpay.com
MOONPAY_CURRENCY_CODE=usdc_base

# Deposits: how often to look for USDC arriving in users' wallets.
DEPOSITS_POLL_MS=10000

# Tap to pay (ADR 0010). The payer must approve within P2P_REQUEST_TTL_MS; the signed transfer is valid
# for P2P_AUTHORIZATION_TTL_MS from the request's creation.
P2P_REQUEST_TTL_MS=120000
P2P_AUTHORIZATION_TTL_MS=600000
# The most one request can ask for, in USDC.
P2P_MAX_AMOUNT_USDC=1000
# The most one sender can send by tap to pay in any 24 hours, in USDC.
P2P_DAILY_LIMIT_USDC=2000
# Open requests per receiver, and requests waiting for one payer's approval (stops tap spam).
P2P_MAX_OPEN_REQUESTS=3
P2P_MAX_AWAITING_PER_SENDER=3
P2P_POLL_MS=2000
# Push: a Google service-account key file (JSON) with Firebase Cloud Messaging access. Without it, no
# push; the payer's "Pay by tap" screen polls instead. Keep the file out of git.
FCM_SERVICE_ACCOUNT_FILE=

# Indexer
INDEXER_POLL_MS=4000
# Blocks to wait before trusting an event. Use 0 on anvil, which only mines when there's a transaction.
INDEXER_CONFIRMATIONS=2
# The settlement contract's deployment block, so the first run doesn't scan the whole chain.
INDEXER_START_BLOCK=0
# Blocks per log query. Base's public RPCs allow 200; with a provider (Alchemy, QuickNode, ...) you can raise it.
INDEXER_MAX_BLOCK_RANGE=200
