# Copy to .env (gitignored). TESTNET KEYS ONLY. Empty values are treated as unset.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Postgres from the root docker-compose.yml. If you set POSTGRES_PORT there, use the same port here.
DATABASE_URL=postgresql://globalpay:globalpay@localhost:5432/globalpay

# Sign-in. JWT_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=86400
# The domain sign-in messages name (EIP-4361). The server writes the message; the app signs it.
SIWE_DOMAIN=globalpay.local

# Chain: Base Sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
EXPLORER_URL=https://sepolia.basescan.org
# Circle USDC on Base Sepolia. Check this against Circle's docs.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Set after deploying contracts/ (iteration 6). Quotes return 503 until it's set.
SETTLEMENT_ADDRESS=

# Backend keys (testnet only). Their addresses get roles in the settlement contract.
QUOTE_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Local chain instead: start anvil, run contracts/script/DeployLocal.s.sol, then use these.
# They're anvil's public test keys (#2 quote signer, #3 relayer): never use them anywhere else.
# CHAIN_ID=31337
# RPC_URL=http://127.0.0.1:8545
# USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# SETTLEMENT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# QUOTE_SIGNER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# RELAYER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Quotes
QUOTE_TTL_SECONDS=60
SPREAD_BPS=100
# true in production: refuse personal (tag 29) PromptPay QRs
MERCHANT_QR_ONLY=false

# Exchange rate. public: Coinbase's public USDC rates. fixed: FIXED_USDC_THB_RATE (offline).
RATE_SOURCE=public
FIXED_USDC_THB_RATE=35.00

# Simulated PromptPay payout partner
PAYOUT_DELAY_MS=3000
# 0..1. Set to 1 to force failures and exercise refunds.
PAYOUT_FAILURE_RATE=0

# Indexer
INDEXER_POLL_MS=4000
INDEXER_CONFIRMATIONS=2
