# Copy to .env (gitignored). TESTNET KEYS ONLY. Empty values are treated as unset.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Postgres from the root docker-compose.yml. If you set POSTGRES_PORT there, use the same port here.
DATABASE_URL=postgresql://globalpay:globalpay@localhost:5432/globalpay
# Leave unset (10 connections). Set to 1 with `npx prisma dev`, which serves one connection at a time.
DATABASE_POOL_SIZE=

# Sign-in. JWT_SECRET must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=86400
# The domain sign-in messages name (EIP-4361). The server writes the message; the app signs it.
SIWE_DOMAIN=globalpay.local

# Chain: Base Sepolia
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
CHAIN_POLL_MS=1000
EXPLORER_URL=https://sepolia.basescan.org
# Circle USDC on Base Sepolia. Check this against Circle's docs.
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Set after deploying contracts/ (iteration 6). Quotes return 503 until it's set.
SETTLEMENT_ADDRESS=

# Backend keys (testnet only). Their addresses get roles in the settlement contract.
QUOTE_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Local chain instead: start anvil, run contracts/script/DeployLocal.s.sol, then use these.
# They're anvil's public test keys (#2 quote signer, #3 relayer): never use them anywhere else.
# CHAIN_ID=31337
# RPC_URL=http://127.0.0.1:8545
# USDC_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# SETTLEMENT_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# QUOTE_SIGNER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# RELAYER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# Quotes
QUOTE_TTL_SECONDS=60
SPREAD_BPS=100
# true in production: refuse personal (tag 29) PromptPay QRs
MERCHANT_QR_ONLY=false

# Exchange rate. public: Coinbase's public USDC rates. fixed: FIXED_USDC_THB_RATE (offline).
RATE_SOURCE=public
FIXED_USDC_THB_RATE=35.00

# Payouts (ADR 0008). simulated: no money moves. xendit: Xendit payouts (sandbox keys only).
PAYOUT_PROVIDER=simulated
PAYOUT_POLL_MS=2000
# How often to ask the partner about a pending payout.
PAYOUT_RECHECK_MS=5000
# A payout still pending after this long becomes UNKNOWN (never settled or refunded automatically).
PAYOUT_PENDING_DEADLINE_MS=1800000
# Refuse quotes that would leave less than this in the partner's float (THB).
PAYOUT_FLOAT_BUFFER_THB=0

# Simulated partner
PAYOUT_DELAY_MS=3000
# 0..1. Set to 1 to force failures and exercise refunds.
PAYOUT_FAILURE_RATE=0
# 0..1. Set to 1 to make every outcome unclear and exercise the operator console.
PAYOUT_UNKNOWN_RATE=0

# Xendit (PAYOUT_PROVIDER=xendit). Test keys from the Xendit dashboard (test mode) only.
XENDIT_SECRET_KEY=
# Dashboard → Settings → Webhooks: the verification token. Webhook URL: <public URL>/webhooks/payouts/xendit
XENDIT_CALLBACK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
# The THB channel for PromptPay IDs (personal QRs), from GET /payouts_channels?currency=THB.
XENDIT_PROMPTPAY_CHANNEL=
# Sandbox only, refused in production: map demo QR targets to Xendit test accounts, e.g.
# {"099999999999901":{"channelCode":"TH_KBANK","accountNumber":"1234567890","accountHolderName":"Test Cafe"}}
PAYOUT_TEST_DESTINATIONS=

# Operator console at /ops. Leave unset to turn it off. At least 32 characters; generate like JWT_SECRET.
OPS_API_TOKEN=
# Flag an UNKNOWN payout as needing a person after this long.
OPS_ESCALATE_AFTER_MS=1800000
# An operator can approve a refund only after the payout has been UNKNOWN this long.
OPS_REFUND_COOLOFF_MS=3600000
# Alert thresholds: relayer gas (ETH) and payout float (THB).
OPS_MIN_RELAYER_ETH=0.005
OPS_MIN_PAYOUT_FLOAT_THB=0

# Indexer
INDEXER_POLL_MS=4000
# Blocks to wait before trusting an event. Use 0 on anvil, which only mines when there's a transaction.
INDEXER_CONFIRMATIONS=2
# The settlement contract's deployment block, so the first run doesn't scan the whole chain.
INDEXER_START_BLOCK=0
