{
  "name": "@globalpay/api",
  "version": "0.1.0",
  "private": true,
  "description": "GlobalPay backend: quotes, relayer, indexer and payouts for stablecoin-to-PromptPay payments",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:testnet": "tsx watch src/main.ts --env .env.base-sepolia",
    "start:testnet": "tsx src/main.ts --env .env.base-sepolia",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "qr:make": "tsx scripts/make-promptpay-qr.ts",
    "xendit:sandbox": "tsx scripts/xendit-sandbox.ts",
    "testnet": "tsx scripts/testnet.ts",
    "dev:near": "tsx watch src/main.ts --env .env.near-testnet",
    "start:near": "tsx src/main.ts --env .env.near-testnet",
    "near:testnet": "tsx scripts/near-testnet.ts",
    "near:vectors": "tsx scripts/near-vectors.ts",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.17",
    "near-api-js": "7.5.3",
    "viem": "2.57.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dotenv": "18.0.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
