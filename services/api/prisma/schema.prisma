// GlobalPay backend data model. Money is stored as integers in minor units:
// USDC base units (6 decimals) and THB satang (2 decimals). Hex values are lowercase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  /// Lowercase 0x wallet address
  walletAddress    String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  kyc              KycRecord?
  quotes           Quote[]
  payments         Payment[]
  onrampOrders     OnrampOrder[]
  deposits         Deposit[]
  /// The name others see when paying this user
  displayName      String?
  /// True only when the name comes from identity verification
  nameVerified     Boolean          @default(false)
  devices          Device[]
  requestsReceived PaymentRequest[] @relation("receiver")
  requestsSent     PaymentRequest[] @relation("sender")
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model KycRecord {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  provider    String
  providerRef String?
  tier        Int       @default(0)
  status      KycStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// One-time nonces for Sign-In with Ethereum (EIP-4361)
model SiweNonce {
  nonce     String    @id
  address   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address])
}

model Quote {
  /// bytes32 hex. Also the EIP-3009 nonce.
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  payer           String
  token           String
  tokenAmount     BigInt
  fiatCurrency    String   @db.Char(3)
  fiatAmount      BigInt
  /// Fiat major units per 1 token, scaled by 1e8, before the spread
  rateE8          BigInt
  spreadBps       Int
  merchantKind    String
  merchantRef     String
  merchantRefHash String
  merchantName    String?
  qrPayload       String
  /// Backend's EIP-712 signature over the quote
  signature       String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  payment         Payment?

  @@index([userId, createdAt])
}

enum PaymentStatus {
  SUBMITTED
  PAID
  PAYOUT_PENDING
  SETTLED
  REFUNDED
  FAILED
}

model Payment {
  id            String        @id @default(cuid())
  quoteId       String        @unique
  quote         Quote         @relation(fields: [quoteId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        PaymentStatus @default(SUBMITTED)
  payTxHash     String?       @unique
  paidBlock     BigInt?
  settleTxHash  String?
  refundTxHash  String?
  /// Why the payment failed, or why it was refunded
  failureReason String?
  /// How the on-chain PaymentReceived event differed from the quote. Never paid out; an operator looks.
  eventMismatch String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  payout        Payout?

  @@index([userId, createdAt])
  @@index([status])
}

/// See src/domain/payment.ts: only SUCCEEDED settles, only FAILED refunds
enum PayoutStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
  REVERSED
}

model Payout {
  id                String        @id @default(cuid())
  paymentId         String        @unique
  payment           Payment       @relation(fields: [paymentId], references: [id])
  provider          String
  /// Sent with every create call to the partner, so a retry can never pay twice
  idempotencyKey    String        @unique
  /// The partner's ID for the payout
  providerRef       String?
  /// Bank or rail reference proving the merchant was paid
  providerReference String?
  providerStatus    String?
  status            PayoutStatus  @default(PENDING)
  currency          String        @db.Char(3)
  amount            BigInt
  attempts          Int           @default(0)
  failureReason     String?
  lastError         String?
  lastCheckedAt     DateTime?
  nextCheckAt       DateTime?
  unknownSince      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  events            PayoutEvent[]

  @@index([status])
}

/// Every partner response, webhook and operator action on a payout, for audit
model PayoutEvent {
  id             String   @id @default(cuid())
  payoutId       String
  payout         Payout   @relation(fields: [payoutId], references: [id])
  /// create | check | webhook | ops
  source         String
  providerStatus String?
  payload        Json
  createdAt      DateTime @default(now())

  @@index([payoutId, createdAt])
}

/// What an operator did, why, and to what
model OpsAction {
  id         String   @id @default(cuid())
  action     String
  targetType String
  targetId   String
  actor      String
  note       String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

/// Last processed block per contract, so the indexer resumes where it stopped
model IndexerCursor {
  /// e.g. "settlement:84532:0xabc..."
  id        String   @id
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

/// See src/domain/onramp.ts: COMPLETED only once the transfer is confirmed on-chain
enum OnrampStatus {
  CREATED
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

/// An "Add money" order with an onramp partner (MoonPay)
model OnrampOrder {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  provider            String
  /// Lowercase; copied from the user when the order is made
  walletAddress       String
  fiatCurrency        String
  fiatAmount          BigInt
  status              OnrampStatus @default(CREATED)
  providerTxId        String?
  providerStatus      String?
  /// Token base units the partner reports sending
  expectedTokenAmount BigInt?
  /// The delivering transfer, once verified on-chain
  txHash              String?
  logIndex            Int?
  receivedAmount      BigInt?
  failureReason       String?
  lastError           String?
  lastCheckedAt       DateTime?
  expiresAt           DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  /// Each on-chain transfer completes at most one order
  @@unique([txHash, logIndex])
  @@index([userId, createdAt])
  @@index([status])
}

/// Token that arrived in a user's wallet from outside (found by the deposit watcher)
model Deposit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  chainId     Int
  /// Lowercase token address
  token       String
  txHash      String
  logIndex    Int
  /// Lowercase sender address
  fromAddress String
  amount      BigInt
  blockNumber BigInt
  createdAt   DateTime @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([userId, createdAt])
}

/// A phone that can be tapped to pay (ADR 0010)
model Device {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  /// SPKI DER, base64: the P-256 key in the phone's hardware keystore
  publicKey String    @unique
  fcmToken  String?
  platform  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  @@index([userId])
  @@index([fcmToken])
}

/// See src/domain/p2p.ts
enum PaymentRequestStatus {
  CREATED
  SENDER_IDENTIFIED
  APPROVING
  SUBMITTED
  COMPLETED
  FAILED
  EXPIRED
  DECLINED
  CANCELLED
}

/// A person-to-person payment request: tap to pay, or scan the receiver's QR
model PaymentRequest {
  id              String               @id @default(cuid())
  receiverId      String
  receiver        User                 @relation("receiver", fields: [receiverId], references: [id])
  /// Lowercase
  receiverAddress String
  /// Copied from the receiver's profile when the request is made
  recipientName   String
  nameVerified    Boolean
  token           String
  amount          BigInt
  /// EIP-3009 nonce (bytes32, random)
  nonce           String               @unique
  /// One-time challenge for the tap or the QR
  challenge       String               @unique
  challengeUsedAt DateTime?
  senderId        String?
  sender          User?                @relation("sender", fields: [senderId], references: [id])
  senderAddress   String?
  senderDeviceId  String?
  /// EIP-3009 validBefore, unix seconds
  validBefore     BigInt
  expiresAt       DateTime
  status          PaymentRequestStatus @default(CREATED)
  txHash          String?              @unique
  failureReason   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([receiverId, createdAt])
  @@index([senderId, status])
  @@index([status])
}
